{
  "name": "Finkfold - Attendance WhatsApp Alert (Free Plan)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "attendance",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-01",
      "name": "Receive from Finkfold",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// *** EDIT THIS NODE ***\n// Paste same value as N8N_ATTENDANCE_WEBHOOK_SECRET in your Finkfold .env.local\nconst EXPECTED_SECRET = \"PASTE_YOUR_SECRET_HERE\";\n\nconst body = $input.first().json;\nconst headers = body.headers || {};\nconst incoming = headers[\"x-finkfold-secret\"] || headers[\"X-Finkfold-Secret\"] || \"\";\n\nif (EXPECTED_SECRET !== \"PASTE_YOUR_SECRET_HERE\" && incoming !== EXPECTED_SECRET) {\n  throw new Error(\"Unauthorized: invalid x-finkfold-secret\");\n}\nreturn [body.body || body];"
      },
      "id": "node-02",
      "name": "1. Validate Secret (EDIT ME)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.is_test }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "node-03",
      "name": "Is Test Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\":true,\"mode\":\"test\",\"msg\":\"Test received - no WhatsApp sent\"}",
        "options": {}
      },
      "id": "node-04",
      "name": "Respond Test OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        960,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "// *** EDIT THIS NODE ***\n// WA_PHONE_NUMBER_ID : Meta Business Manager > WhatsApp Manager > API Setup\n// WA_ACCESS_TOKEN    : Meta Business Manager > System Users > Generate Token\nconst WA_PHONE_NUMBER_ID = \"PASTE_PHONE_NUMBER_ID_HERE\";\nconst WA_ACCESS_TOKEN    = \"PASTE_META_ACCESS_TOKEN_HERE\";\n\nconst d = $input.first().json;\nconst tpl = d.event_type === \"absent\" ? \"school_absence_alert_v1\" : \"school_correction_v1\";\n\nreturn [{\n  _url: `https://graph.facebook.com/v19.0/${WA_PHONE_NUMBER_ID}/messages`,\n  _token: WA_ACCESS_TOKEN,\n  _input: d,\n  _payload: JSON.stringify({\n    messaging_product: \"whatsapp\",\n    recipient_type: \"individual\",\n    to: d.parent_phone,\n    type: \"template\",\n    template: {\n      name: tpl,\n      language: { code: \"en\" },\n      components: [{ type: \"body\", parameters: [\n        { type: \"text\", text: d.parent_name || \"Parent\" },\n        { type: \"text\", text: d.student_name },\n        { type: \"text\", text: d.class_label },\n        { type: \"text\", text: d.attendance_date }\n      ]}]\n    }\n  })\n}];"
      },
      "id": "node-05",
      "name": "2. Build Payload (EDIT ME)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json._url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $json._token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json._payload }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "node-06",
      "name": "Send WhatsApp via Meta API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        420
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// *** EDIT THIS NODE ***\n// CALLBACK_URL examples:\n//   Production : https://yourdomain.com/api/webhook/whatsapp-status\n//   Local dev  : https://xxxx.ngrok.io/api/webhook/whatsapp-status  (use ngrok)\nconst CALLBACK_URL = \"PASTE_FINKFOLD_CALLBACK_URL_HERE\";\n// Same secret as node 1\nconst SECRET = \"PASTE_YOUR_SECRET_HERE\";\n\nconst meta = $input.first().json;\nconst d = $(\"2. Build Payload (EDIT ME)\").first().json._input;\nconst msgId = meta?.messages?.[0]?.id || null;\nconst status = msgId ? \"delivered\" : \"failed\";\n\nreturn [{\n  _callbackUrl: CALLBACK_URL,\n  _secret: SECRET,\n  _body: {\n    school_id: d.school_id,\n    session_id: d.session_id || null,\n    student_id: d.student_id,\n    parent_phone: d.parent_phone,\n    event_type: d.event_type,\n    attendance_date: d.attendance_date,\n    template_name: d.event_type === \"absent\" ? \"school_absence_alert_v1\" : \"school_correction_v1\",\n    status: status,\n    meta_message_id: msgId,\n    is_test: false\n  }\n}];"
      },
      "id": "node-07",
      "name": "3. Prepare Callback (EDIT ME)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json._callbackUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-finkfold-secret",
              "value": "={{ $json._secret }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json._body) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "node-08",
      "name": "Write Status to Finkfold",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        420
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, status: $(\"3. Prepare Callback (EDIT ME)\").first().json._body.status }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-09",
      "name": "Respond to Finkfold",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1920,
        420
      ]
    }
  ],
